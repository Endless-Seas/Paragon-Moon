/datum/faith/old_god
	name = "The Maker"
	desc = "In an attempt to unify the many scattered faiths throughout the land, it was the Empire that first uttered the name Psydon. \
	Their reformist ways established a new order that was to spread far and beyond the borders of their nation. \
	While the truth of creation remains a myth, to every Otavan it is clear as day, Psydon is all. \
	One god, one realm of His creation, one unified people through faith."
	worshippers = "Imperial Clergy. Converts. The Lost."
	godhead = /datum/patron/old_god
